{
  "name": "pelota-parada",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pelota-parada",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@pelota-parada/api",
      "version": "0.0.0"
    },
    "apps/mobile": {
      "name": "@pelota-parada/mobile",
      "version": "0.0.0"
    },
    "node_modules/@pelota-parada/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@pelota-parada/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@pelota-parada/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "packages/domain": {
      "name": "@pelota-parada/domain",
      "version": "0.0.0"
    }
  }
}
