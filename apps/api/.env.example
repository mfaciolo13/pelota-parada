PORT=3000
# URL del proyecto de Supabase (Project Settings > API). La API valida los tokens con sus claves publicas.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Cadena del Transaction pooler de Supabase (Connect en el panel del proyecto). La usa la API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Conexion directa de Supabase (Direct connection, o Session pooler si tu red no tiene IPv6). La usa solo Prisma para migrar.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
